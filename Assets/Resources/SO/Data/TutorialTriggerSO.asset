  m_Script: {fileID: 11500000, guid: c44822fd0cf3e6447819922fbda4bad8, type: 3}
  m_Name: TutorialTriggerSO
  m_EditorClassIdentifier: App::TutorialTriggerSO
  entries:
  - Type: 0
    Dialogues:
    - "\uBC84\uD2BC\uC744 \uD1B5\uD574 \uD2B9\uC815 \uD0C0\uC785\uC758 AI\uC640 \uAC8C\uC784\uC744
      \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uC2B9\uB9AC\uD558\uBA74 \uB2E4\uC74C AI\uAC00 \uD574\uAE08\uB429\uB2C8\uB2E4"
  - Type: 1
    Dialogues:
    - "\uAC01 \uD300\uB07C\uB9AC \uCD1D 5\uAC1C\uC758 \uCE74\uB4DC\uB97C \uBF51\uC2B5\uB2C8\uB2E4"
    - "\uCD1D \uACF5\uACA9\uB825\uACFC \uBC29\uC5B4\uB825, \uADF8\uB9AC\uACE0 \uBCF4\uB108\uC2A4\uC758
      \uCD1D\uD569\uC774 \uB192\uC740 \uD300\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4"
    - "\uB610\uD55C, \uCE74\uB4DC\uB97C \uBF51\uACE0 \uBC14\uB85C \uC2A4\uD0AC\uC744
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uBC34\uC740 1\uAC1C\uC529 \uBC88\uAC08\uC544\uAC00\uBA70 \uC9C4\uD589\uD558\uACE0,
      \uAC8C\uC784 \uC2DC\uC791 \uC2DC 3\uAC1C, 3\uD53D\uAE4C\uC9C0 \uC9C4\uD589\uB41C
      \uD6C4 2\uAC1C\uC758 \uBC34\uC774 \uC9C4\uD589\uB429\uB2C8\uB2E4"
    - "\uD53D\uC740 \uBE14\uB8E8\uD300 \uC120\uD53D \uC774\uD6C4 2\uAC1C\uC529 \uBC88\uAC08\uC544
      \uD53D\uD558\uACE0 \uB808\uB4DC\uD300\uC774 \uB9C8\uC9C0\uB9C9 \uD53D\uC744
      \uD569\uB2C8\uB2E4"
  - Type: 2
    Dialogues:
    - "2\uC138\uD2B8\uBD80\uD130\uB294 \uC774\uC804\uC5D0 \uD53D\uD55C \uCE74\uB4DC\uB97C
      \uACE0\uB974\uC9C0 \uBABB\uD558\uB294 \uD53C\uC5B4\uB9AC\uC2A4 \uB8F0\uC774
      \uC801\uC6A9\uB429\uB2C8\uB2E4"
    - "\uB9CC\uC57D 3\uC138\uD2B8\uC5D0 \uAC04\uB2E4\uBA74 1,2\uC138\uD2B8\uC5D0
      \uD53D\uD55C \uCE74\uB4DC\uAC00 \uC804\uBD80 \uBE44\uD65C\uC131\uD654\uB429\uB2C8\uB2E4"
  - Type: 3
    Dialogues:
    - "\uC219\uB828\uB3C4\uB97C \uC62C\uB824\uC11C \uD2B9\uC815 \uCE74\uB4DC\uC758
      \uC2A4\uD0EF\uC744 \uB192\uC778 \uC0C1\uD0DC\uB85C \uAC8C\uC784\uC744 \uC2DC\uC791\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uCE74\uB4DC\uB9C8\uB2E4 \uC2A4\uD0EF\uBCC4 1\uBC88\uC529 \uAC15\uD654\uAC00
      \uAC00\uB2A5\uD569\uB2C8\uB2E4"
  _uiTutorial: {fileID: 5179135095201166203, guid: 308f008ac867816449398520e64d8d84, type: 3}
