  entries:
  - ScheduleIndex: 0
    Dialogues:
    - "\uB2E4\uC74C \uAC8C\uC784 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBC30\uD2C0\uC744
      \uC2DC\uC791\uD558\uC138\uC694"
  - ScheduleIndex: 2
    Dialogues:
    - "\uAC8C\uC784\uC774 \uB05D\uB098\uBA74 \uC77C\uC815\uC774 \uC9C4\uD589\uB418\uACE0,
      \uC21C\uC704\uAC00 \uAE30\uB85D\uB429\uB2C8\uB2E4"
    - "\uB2E4\uC74C \uAC8C\uC784 \uC2DC\uC791 \uC804\uC5D0 \uC219\uB828\uB3C4 \uD0ED\uC5D0\uC11C
      \uC6D0\uD558\uB294 \uCE74\uB4DC\uC758 \uC2A4\uD0EF\uC744 \uC62C\uB9B4 \uC218
      \uC788\uC2B5\uB2C8\uB2E4"
    - "\uAC01 \uC2A4\uD0EF\uBCC4 1\uBC88\uC529 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00
      \uAC00\uB2A5\uD558\uBA70 \uBC30\uD2C0\uC2DC \uD50C\uB808\uC774\uC5B4 \uC815\uBCF4\uC5D0
      \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824 \uC2A4\uD0EF\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - ScheduleIndex: 3
    Dialogues:
    - "\uBAA8\uB4E0 \uC77C\uC815\uC774 \uB05D\uB098\uBA74 \uC21C\uC704\uC5D0 \uB530\uB77C
      \uC0C1\uC704 4\uD300\uC774 \uD1A0\uB108\uBA3C\uD2B8\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4"
