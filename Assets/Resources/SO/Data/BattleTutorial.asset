  m_Script: {fileID: 11500000, guid: b8bc53f740d952549b8f5885148db49b, type: 3}
  m_Name: BattleTutorial
  m_EditorClassIdentifier: App::TutorialDataSO
  entries:
  - ScheduleIndex: 1
    Dialogues:
    - "\uCE74\uB4DC\uB97C \uBF51\uC544 \uACF5\uACA9 + \uBC29\uC5B4 + \uAD6C\uAC04
      \uBCF4\uB108\uC2A4\uC758 \uCD1D\uD569\uC774 \uB354 \uB192\uC740 \uCABD\uC774
      \uC2B9\uB9AC\uD569\uB2C8\uB2E4"
    - "\uBC34\uC740 \uBC88\uAC08\uC544\uAC00\uBA70 1\uAC1C\uC529 \uC120\uD0DD\uD569\uB2C8\uB2E4"
    - "\uBE14\uB8E8 \uD300\uC774 1\uD53D\uD6C4 \uBC88\uAC08\uC544\uAC00\uBA70 2\uAC1C\uC529
      \uC120\uD0DD\uD569\uB2C8\uB2E4"
    - "\uBC34 \u2794 3\uD53D \u2794 2\uBC34 \u2794 2\uD53D \uD398\uC774\uC988\uB85C
      \uC9C4\uD589\uB429\uB2C8\uB2E4"
    - "\uCE74\uB4DC\uB97C \uBF51\uB294 \uC989\uC2DC \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD574\uC57C
      \uD558\uBA70, \uC9C0\uC815\uD560 \uB300\uC0C1\uC774 \uC5C6\uB2E4\uBA74 \uADF8\uB300\uB85C
      \uD134\uC774 \uB118\uC5B4\uAC11\uB2C8\uB2E4"
  - ScheduleIndex: 2
    Dialogues:
    - "\uD300 \uC120\uD0DD\uAD8C\uC774 \uC788\uC744 \uACBD\uC6B0 \uAC8C\uC784 \uC2DC\uC791
      \uC804\uC5D0 \uC120\uD0DD\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4"
  - ScheduleIndex: 3
    Dialogues:
    - "\uC774\uC81C\uBD80\uD130 \uAC8C\uC784\uC740 3\uD310 2\uC120\uC73C\uB85C \uC9C4\uD589\uB429\uB2C8\uB2E4"
    - "\uD55C \uBC88 \uD53D\uD55C \uCE74\uB4DC\uB294 \uB2E4\uC74C \uC138\uD2B8\uBD80\uD130\uB294
      \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
    - "\uB610\uD55C \uD328\uBC30\uD300\uC774 \uC9C4\uC601\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4"
