  m_Script: {fileID: 11500000, guid: c44822fd0cf3e6447819922fbda4bad8, type: 3}
  m_Name: TutorialTriggerSO
  m_EditorClassIdentifier: App::TutorialTriggerSO
  entries:
  - Type: 0
    Dialogues:
    - "\uC774 \uAC8C\uC784\uC740 \uAC01 \uD300\uC774 \uCD1D 5\uAC1C\uC758 \uCE74\uB4DC\uB97C
      \uBF51\uC740 \uACB0\uACFC\uB85C \uCD1D \uC810\uC218\uAC00 \uB192\uC740 \uD300\uC774
      \uC2B9\uB9AC\uD569\uB2C8\uB2E4"
    - "\uBA3C\uC800 \uBC34\uC744 \uD558\uAC8C \uB429\uB2C8\uB2E4. \uCC98\uC74C\uC5D0
      3\uAC1C\uC529, \uADF8\uB9AC\uACE0 \uC11C\uB85C 3\uAC1C\uC529 \uD53D\uD55C \uD6C4
      2\uAC1C\uB97C \uB610 \uBC34\uD569\uB2C8\uB2E4"
  - Type: 3
    Dialogues:
    - "\uCE74\uB4DC\uB294 \uC810\uC218\uC5D0 \uBC18\uC601\uB418\uB294 \uC2A4\uD0EF\uACFC,
      \uD53D\uD568\uACFC \uB3D9\uC2DC\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294
      \uC2A4\uD0AC\uC744 \uAC00\uC9D1\uB2C8\uB2E4"
    - "\uC2A4\uD0AC\uC758 \uBC94\uC704\uC640 \uC870\uAC74\uC5D0 \uB530\uB77C \uC801\uC6A9
      \uB300\uC0C1\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4"
  - Type: 2
    Dialogues:
    - "\uC219\uB828\uB3C4\uB97C \uC62C\uB824\uC11C \uD2B9\uC815 \uCE74\uB4DC\uC758
      \uC2A4\uD0EF\uC744 \uB192\uC778 \uC0C1\uD0DC\uB85C \uAC8C\uC784\uC744 \uC2DC\uC791\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uCE74\uB4DC\uB9C8\uB2E4 \uC2A4\uD0EF\uBCC4 1\uBC88\uC529 \uAC15\uD654\uAC00
      \uAC00\uB2A5\uD569\uB2C8\uB2E4"
  - Type: 4
    Dialogues:
    - "\uD558\uB098\uC758 \uC138\uD2B8\uAC00 \uB05D\uB098\uBA74 \uCE74\uB4DC\uB97C
      \uBC14\uAFB8\uB294 \uC2A4\uC651\uC774 \uC9C4\uD589\uB429\uB2C8\uB2E4"
    - "\uC774\uC804\uC5D0 \uC0AC\uC6A9\uD55C \uCE74\uB4DC\uB294 \uACE0\uB97C \uC218
      \uC5C6\uC73C\uBBC0\uB85C \uBB34\uC870\uAC74 \uAD50\uCCB4\uD574\uC57C\uD569\uB2C8\uB2E4"
  _uiTutorial: {fileID: 5179135095201166203, guid: 308f008ac867816449398520e64d8d84, type: 3}
