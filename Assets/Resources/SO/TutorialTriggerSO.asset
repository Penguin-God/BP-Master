  m_Name: TutorialTriggerSO
  m_EditorClassIdentifier: App::TutorialTriggerSO
  entries:
  - TutorialType: 1
    TriggerType: 2
    Dialogues:
    - "\uAC8C\uC784\uC774 \uC2DC\uC791\uB418\uBA74 \uCE74\uB4DC\uB97C  \uACE0\uB97C
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uCE74\uB4DC\uB294 \uC2A4\uD0EF\uACFC \uC2A4\uD0AC\uC744 \uAC00\uC9D1\uB2C8\uB2E4"
    - "\uBAA8\uB4E0 \uC120\uD0DD\uC774 \uB05D\uB098\uACE0 \uD53D\uD55C \uCE74\uB4DC
      5\uC7A5\uC758 \uACF5\uACA9, \uBC29\uC5B4, \uBCF4\uB108\uC2A4\uC758 \uD569\uC774
      \uB192\uC740 \uCABD\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4"
    - "\uC790\uC2E0\uC5D0\uAC8C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uC2A4\uD0AC\uC744
      \uAC00\uC9C4 \uCE74\uB4DC\uB97C \uD53D\uD574\uBCF4\uC138\uC694"
    AnswerCards:
    - {fileID: 11400000, guid: 96e5b2be14ec2e44fb3a39b5e7d7f8b5, type: 2}
    - {fileID: 11400000, guid: dd2a439d0aa446149aff7b1d1a126d70, type: 2}
    - {fileID: 11400000, guid: de981b4337927514d81fd75ae700058e, type: 2}
    - {fileID: 11400000, guid: f8affce91ca1c634c8f1c9b128bea301, type: 2}
    - {fileID: 11400000, guid: 68db2d501243ac24a8432076374f5535, type: 2}
    - {fileID: 11400000, guid: 82ef325c9ca8ec540a02f175838ee179, type: 2}
    - {fileID: 11400000, guid: efc97c7ed14228b44b5409f4547a3892, type: 2}
    - {fileID: 11400000, guid: fb992e3516fe1cb4abc73e44bf105be7, type: 2}
    - {fileID: 11400000, guid: 686de373f55d3af47be95b7fd6d47937, type: 2}
    - {fileID: 11400000, guid: 6bfc90ab66bb4ba45b706202167930bd, type: 2}
    - {fileID: 11400000, guid: a497d423f384741408ba842e548208a9, type: 2}
    - {fileID: 11400000, guid: 82ef325c9ca8ec540a02f175838ee179, type: 2}
    - {fileID: 11400000, guid: 501399a5d79b3944d8ff9848526fa637, type: 2}
    - {fileID: 11400000, guid: e1a3b2221509f4f41a0ba6f414d92291, type: 2}
    - {fileID: 11400000, guid: 0c4abe03433751347b882db35b368f90, type: 2}
    - {fileID: 11400000, guid: 0dc80b517b75a554fb14e80936d977e0, type: 2}
    - {fileID: 11400000, guid: 7ce020f57f367594380e9010092c1b2e, type: 2}
    - {fileID: 11400000, guid: f8affce91ca1c634c8f1c9b128bea301, type: 2}
    SuccessDialogues:
    - "\uC131\uACF5\uC785\uB2C8\uB2E4. \uCCAB \uBC88\uC9F8 \uD53D\uC740 \uC0C1\uB300\uBC29\uC774
      \uC5C6\uAE30 \uB54C\uBB38\uC5D0 \uC801\uC5D0\uAC8C \uB514\uBC84\uD504\uB97C
      \uC904 \uC2A4\uD0AC\uC740 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
    - "\uD558\uC9C0\uB9CC \uBC84\uD504 \uC2A4\uD0AC\uC740 \uD53D\uC744 \uD55C \uCE74\uB4DC\uC5D0
      \uBC14\uB85C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uCE74\uB4DC\uB97C \uD074\uB9AD\uD574 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD574\uBCF4\uC138\uC694"
    FailDialogues:
    - "\uADF8 \uCE74\uB4DC\uC758 \uC2A4\uD0AC\uC740 \uBCF8\uC778\uC5D0\uAC8C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
    - "\uC2A4\uD0AC \uC911 \uC790\uC2E0\uC758 \uCE74\uB4DC\uC5D0 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uB294 \uCE74\uB4DC\uB97C \uACE8\uB77C\uC11C \uD53D\uD574\uBCF4\uC138\uC694"
  - TutorialType: 1
    TriggerType: 3
    Dialogues:
    - "\uC774\uC81C \uC0C1\uB300\uAC00 \uCE74\uB4DC\uB97C \uACE8\uB790\uC2B5\uB2C8\uB2E4"
    - "\uC774\uBC88\uC5D0\uB294 \uC0C1\uB300\uC5D0\uAC8C \uB514\uBC84\uD504\uB97C
      \uC8FC\uB294 \uCE74\uB4DC\uB97C \uACE8\uB77C\uBCF4\uC138\uC694"
    AnswerCards:
    - {fileID: 11400000, guid: 4e753bb0a72f5444db3fba58e02128d2, type: 2}
    - {fileID: 11400000, guid: e492800f37830f841900e48b1185b3a9, type: 2}
    - {fileID: 11400000, guid: bae25939c5722db438b3cdf8300db2e0, type: 2}
    - {fileID: 11400000, guid: 550666d0e7409ec41ba97eb5c0577369, type: 2}
    - {fileID: 11400000, guid: b1f469ab928f4d845822d4111588ca2f, type: 2}
    - {fileID: 11400000, guid: 053524781a5d45b418eac638b686588a, type: 2}
    - {fileID: 11400000, guid: bae25939c5722db438b3cdf8300db2e0, type: 2}
    - {fileID: 11400000, guid: df641881a5eedeb40849768c49193a08, type: 2}
    - {fileID: 11400000, guid: 58474179d6dc6f64789a4d7b560f383e, type: 2}
    - {fileID: 11400000, guid: 60dab3d317cc31041b562864be0717e4, type: 2}
    - {fileID: 11400000, guid: 5845e19649f08d247b70aac6efe18d8f, type: 2}
    - {fileID: 11400000, guid: 23cad2dd0631ef64d9d44e30de06bb2e, type: 2}
    - {fileID: 11400000, guid: 49809e8e360b92940a2612303a17878e, type: 2}
    - {fileID: 11400000, guid: eca6152df43791743af3aeb3eae86012, type: 2}
    - {fileID: 11400000, guid: d7000890dfa10bf4f9ede95f43d04424, type: 2}
    SuccessDialogues:
    - "\uC131\uACF5\uD588\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uC801 \uCE74\uB4DC\uB97C
      \uD074\uB9AD\uD574 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD574\uBCF4\uC138\uC694"
    FailDialogues:
    - "\uADF8 \uCE74\uB4DC\uC758 \uC2A4\uD0AC\uC740 \uC0C1\uB300\uBC29\uC5D0\uAC8C
      \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
    - "\uC0C1\uB300\uC5D0\uAC8C \uB514\uBC84\uD504\uB97C \uC8FC\uB294 \uCE74\uB4DC\uB97C
      \uACE8\uB77C\uBCF4\uC138\uC694"
  - TutorialType: 1
    TriggerType: 4
    Dialogues:
    - "\uC88B\uC2B5\uB2C8\uB2E4. \uC801\uC5D0\uAC8C \uB514\uBC84\uD504 \uC2A4\uD0AC\uC744
      \uC0AC\uC6A9\uD558\uC600\uC2B5\uB2C8\uB2E4"
    - "\uC774\uBC88\uC5D0\uB294 \uC2A4\uD0AC\uC774 \uC544\uB2CC \uC2A4\uD0EF\uC744
      \uCC59\uACA8\uBCF4\uB3C4\uB85D \uD569\uC2DC\uB2E4"
    - "\uC2A4\uD0EF \uC911 \uC18D\uB3C4\uB294 \uB192\uC740 \uBCF4\uB108\uC2A4 \uC810\uC218\uB97C
      \uC90D\uB2C8\uB2E4"
    - "\uC18D\uB3C4 \uC2A4\uD0EF\uC774 6\uC774\uC0C1\uC778 \uCE74\uB4DC\uB97C \uC120\uD0DD\uD574\uBCF4\uC138\uC694"
    AnswerCards:
    - {fileID: 11400000, guid: 5f5c7591caea4e04b816869d96af3a1f, type: 2}
    - {fileID: 11400000, guid: 82ef325c9ca8ec540a02f175838ee179, type: 2}
    - {fileID: 11400000, guid: 68db2d501243ac24a8432076374f5535, type: 2}
    - {fileID: 11400000, guid: a497d423f384741408ba842e548208a9, type: 2}
    - {fileID: 11400000, guid: 603c87e43456fd44286208c78097ee82, type: 2}
    - {fileID: 11400000, guid: 49809e8e360b92940a2612303a17878e, type: 2}
    SuccessDialogues:
    - "\uC131\uACF5\uC785\uB2C8\uB2E4. \uD654\uBA74 \uC704\uC5D0 \uBCF4\uB108\uC2A4
      \uAE30\uC900\uC744 \uD655\uC778\uD574\uC11C \uCD5C\uB300\uD55C \uB9CE\uC740
      \uC810\uC218\uB97C \uD68D\uB4DD\uD574\uBCF4\uC138\uC694"
    FailDialogues:
    - "\uADF8 \uCE74\uB4DC\uB294 \uC18D\uB3C4 \uC2A4\uD0EF\uC774 6\uC774 \uC544\uB2D9\uB2C8\uB2E4"
    - "\uC18D\uB3C4 \uC2A4\uD0EF\uC774 6\uC774\uC0C1\uC778 \uCE74\uB4DC\uB97C \uC120\uD0DD\uD574\uBCF4\uC138\uC694"
  - TutorialType: 0
    TriggerType: 5
    Dialogues:
    - "\uC11C\uB85C 3\uAC1C\uC758 \uD53D\uC744 \uD588\uC744 \uB54C \uCE74\uB4DC\uB97C
      \uBC34\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    - "\uAC01\uAC01 2\uAC1C\uC758 \uBC34\uCE74\uB4DC\uB97C \uAC00\uC9C0\uBA70 \uBC88\uAC08\uC544\uAC00\uBA70
      \uC9C4\uD589\uD569\uB2C8\uB2E4"
    - "\uC774\uBBF8 3\uAC1C\uC758 \uCE74\uB4DC\uAC00 \uC788\uACE0 \uC870\uAC74\uC744
      \uAC00\uC9C4 \uC2A4\uD0AC\uC740 \uBA87\uBA87 \uC0C1\uD669\uC5D0\uC11C \uB354
      \uAC15\uB825\uD55C \uACBD\uC6B0\uAC00 \uB9CE\uC2B5\uB2C8\uB2E4"
    - "\uC774\uB7F0 \uAC83\uB4E4\uC744 \uD655\uC778\uD558\uACE0 \uBC34\uC744 \uD558\uBA74
      \uC88B\uC2B5\uB2C8\uB2E4"
    AnswerCards: []
    SuccessDialogues: []
    FailDialogues: []
  - TutorialType: 0
    TriggerType: 6
    Dialogues:
    - "\uC0C8\uB85C\uC6B4 \uAC8C\uC784\uC774 \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    - "2\uBC88\uC9F8 \uAC8C\uC784\uBD80\uD130\uB294 \uC774\uC804\uC5D0 \uC591\uD300\uC774
      \uD53D\uD55C \uCE74\uB4DC\uB97C \uC120\uD0DD\uD560 \uC218 \uC5C6\uB294 \uD53C\uC5B4\uB9AC\uC2A4
      \uB8F0\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4"
    - "2\uC138\uD2B8\uB294 10\uAC1C, 3\uC138\uD2B8\uB294 20\uAC1C\uC758 \uCE74\uB4DC\uAC00
      \uAE08\uC9C0\uB41C \uC0C1\uD0DC\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4"
    - "\uD2B9\uC815 \uCE74\uB4DC\uAC00 \uBE60\uC9C4 \uAC83\uC744 \uC774\uC6A9\uD574
      \uB354 \uAC15\uB825\uD55C \uC804\uB7B5\uC744 \uC2E4\uD589\uD558\uC138\uC694"
    AnswerCards: []
    SuccessDialogues: []
    FailDialogues: []
  _uiTutorial: {fileID: 5179135095201166203, guid: 308f008ac867816449398520e64d8d84, type: 3}
